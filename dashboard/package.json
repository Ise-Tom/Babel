{
  "name": "babel-progress-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "data": "python3 ../scripts/build_dashboard.py",
    "build": "npm run data && node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:build": "node --test tests/build.test.mjs",
    "test:e2e": "playwright test",
    "preview": "python3 -m http.server 4173 --bind 0.0.0.0 --directory dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
